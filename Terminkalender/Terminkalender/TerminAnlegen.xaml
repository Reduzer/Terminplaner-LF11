<Page x:Class="Terminkalender.TerminAnlegen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Terminkalender"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="450"
      Title="TerminAnlegen" >

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FC466B" Offset="0.0"/>

            <GradientStop Color="#3F5EFB" Offset="1.0"/>

            <GradientStop Color="#f64f59" Offset="1.0"/>
        </LinearGradientBrush>
    </Page.Background>


    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                            <Border.Style>
                                <Style/>
                            </Border.Style>
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
       
        <TextBlock Text="Neuen Termin anlegen" FontSize="20" FontWeight="Thin" Grid.Row="0" Foreground="White"/>

        <!--Titel, Wiederholung-->

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            
            <TextBlock Text="Titel:" Width="60" VerticalAlignment="Center" Foreground="White"/>

            <Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White">
                <TextBox x:Name="TitleBox" Width="200" BorderThickness="0" Margin="1"/>
            </Border>

            <TextBlock Text="Wiederholen:" VerticalAlignment="Center" Foreground="White" Margin="10,0,5,0" />

            <Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" >
                <TextBox x:Name="RepeatBox" Width="50" BorderThickness="0" Margin="1"/>
            </Border>

        </StackPanel>
        
        <!--Datum, Von:, Bis:-->

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            
            <TextBlock Text="Datum:" Width="60" VerticalAlignment="Center" Foreground="White"/>

            <Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" VerticalAlignment="Center">
                <DatePicker x:Name="DatePicker" Width="140" BorderBrush="White" Margin="1"/>
            </Border>
            
            <TextBlock Text="Von:" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="White"/>
            
            <Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" VerticalAlignment="Center">
                <ComboBox x:Name="StartBox" Width="60" BorderThickness="0">
                    <ComboBoxItem>ComboBox Item #1</ComboBoxItem>
                    <ComboBoxItem IsSelected="True">ComboBox Item #2</ComboBoxItem>
                    <ComboBoxItem>ComboBox Item #3</ComboBoxItem>
                </ComboBox>
            </Border>

            <TextBlock Text="Bis:" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="White"/>

            <Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" VerticalAlignment="Center">
                <TextBox x:Name="EndBox" Width="60" Margin="1" BorderThickness="0"/>
            </Border>
            
        </StackPanel>
        
        <!--Teilnehmer-->

        <StackPanel Grid.Row="3" Margin="0,10,0,0">

            <TextBlock Text="Teilnehmer:" VerticalAlignment="Center" Foreground="White"/>

            <Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White">
                <TextBox x:Name="TeilnehmerBox" AcceptsReturn="True" Margin="1" BorderThickness="0"/>
            </Border>

        </StackPanel>

        <!--Notizen-->

        <StackPanel Grid.Row="4" Margin="0,10,0,0">

            <TextBlock Text="Beschreibung:" Foreground="White"/>
            
            <Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White">
                <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="1" BorderThickness="0"/>
            </Border>
            
        </StackPanel>
                
        <!--Buttons Speichern und Abbrechen-->

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Speichern" Width="80" Margin="0,0,10,0" Background="White" FontSize="10" Click="SavedClick"/>
            <Button Content="Abbrechen" Width="80" Background="White" FontSize="10"/>
        </StackPanel>
        
    </Grid>
</Page>


<Page x:Class="Terminkalender.Pages.DetailAnsichtTermin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Terminkalender.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
			d:DesignWidth="800"
      Title="DetailAnsichtTermin"
			Background="Transparent">

	<Page.Resources>
		<ResourceDictionary Source="/ResourceDictonaries/Buttons.xaml" />
	</Page.Resources>
	
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="40"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="40"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<TextBlock Text="Test" Name="HeaderForAppointment" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="35"/>
		</Grid>

		<Grid Grid.Row="1">
			<Grid Margin="10">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!--Datum, Von:, Bis:-->

				<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">

					<TextBlock Text="Von Datum:" Width="60" VerticalAlignment="Center" Foreground="White"/>

					<Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" VerticalAlignment="Center" Margin="5,0,10,0">
						<DatePicker x:Name="DatePickerVon" Width="140" BorderBrush="White" Margin="1" IsEnabled="False"/>
					</Border>

					<TextBlock Text="Bis Datum:" Width="60" VerticalAlignment="Center" Foreground="White"/>

					<Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" VerticalAlignment="Center" Margin="5,0,10,0">
						<DatePicker x:Name="DatePickerBis" Width="140" BorderBrush="White" Margin="1" IsEnabled="False"/>
					</Border>

					<TextBlock Text="Von:" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="White"/>

					<Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" VerticalAlignment="Center">
						<ComboBox x:Name="StartBox" Width="60" BorderThickness="0" IsEnabled="False" Margin="1"/>
					</Border>

					<TextBlock Text="Bis:" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="White"/>

					<Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" VerticalAlignment="Center">
						<ComboBox x:Name="EndBox" Width="60" Margin="1" BorderThickness="0" IsEnabled="False"/>
					</Border>

				</StackPanel>

				<StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
					<TextBlock Text="Wiederholen:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0" />
                    <Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" VerticalAlignment="Center">
						<ComboBox x:Name="RepeatBox" Width="50" BorderThickness="0" IsEnabled="False" Margin="1">
							<ComboBoxItem Content="Ja"/>
							<ComboBoxItem Content="Nein"/>
						</ComboBox>
					</Border>

					<TextBlock  Text="Interval:" VerticalAlignment="Center" Foreground="White" Margin="10,0,5,0"/>
					<Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White" >
						<ComboBox Name="IntervalComboBox" Width="50" IsEnabled="False" Margin="1"/>
					</Border>
				</StackPanel>

				<!--Ort-->

				<StackPanel Grid.Row="4" Margin="0,10,0,0">

					<TextBlock Text="Ort:" VerticalAlignment="Center" Foreground="White"/>

					<Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White">
						<TextBox x:Name="OrtBox" AcceptsReturn="True" Margin="1" BorderThickness="0" IsEnabled="False"/>
					</Border>

				</StackPanel>

				<!--Teilnehmer-->

				<StackPanel Grid.Row="5" Margin="0,10,0,0">

					<TextBlock Text="Teilnehmer:" VerticalAlignment="Center" Foreground="White"/>

					<Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White">
						<TextBox x:Name="TeilnehmerBox" AcceptsReturn="True" Margin="1" BorderThickness="0" IsEnabled="False"/>
					</Border>

				</StackPanel>

				<!--Notizen-->

				<StackPanel Grid.Row="6" Margin="0,10,0,0">

					<TextBlock Text="Beschreibung:" Foreground="White"/>

					<Border CornerRadius="5" BorderBrush="White" BorderThickness="1" Background="White">
						<TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="1" BorderThickness="0" IsEnabled="False"/>
					</Border>

				</StackPanel>
			</Grid>
		</Grid>

		<Grid Grid.Row="2">
			<Button Name="ButtonBack" Style="{DynamicResource  ButtonStyle1}" Content="Zurück" Height="40" Width="80" Margin="0,0,600,0" Click="ButtonBack_Click"/>
			<Button Name="ButtonEdit" Style="{DynamicResource  ButtonStyle1}" Content="Bearbeiten" Height="40" Width="80" Margin="600,0,0,0" Click="ButtonEdit_Click"/>
		</Grid>
	</Grid>
</Page>

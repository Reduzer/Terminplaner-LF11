<Page
    x:Class="Terminkalender.Pages.TagesAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Terminkalender.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TagesAnsicht"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ShowsNavigationUI="False"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Offset="0.0" Color="#23074d" />
                <GradientStop Offset="1.0" Color="#cc5333" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*" />
            <RowDefinition Height="80*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*" />
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="25*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*" />
                <RowDefinition Height="60*" />
                <RowDefinition Height="20*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="TxtDate"
                Grid.Row="1"
                Grid.Column="1"
                Background="Transparent"
                Foreground="Black" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                x:Name="DGTermine"
                Grid.Column="0"
                AutoGenerateColumns="True"
                Background="Transparent"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                IsReadOnly="True" />

            <Frame Grid.Column="1" Source="\Pages\TerminAnlegen.xaml" />
        </Grid>
    </Grid>
</Page>

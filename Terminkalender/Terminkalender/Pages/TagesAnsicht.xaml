<Page
    x:Class="Terminkalender.Pages.TagesAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Terminkalender.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TagesAnsicht"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ShowsNavigationUI="false"
    mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary Source="/ResourceDictonaries/Buttons.xaml"/>
	</Page.Resources>

	<Grid Background="Transparent">
		<Grid.RowDefinitions>
            <RowDefinition Height="20*" />
            <RowDefinition Height="80*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*" />
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="25*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*" />
                <RowDefinition Height="60*" />
                <RowDefinition Height="20*" />
            </Grid.RowDefinitions>
					
            <TextBlock
                x:Name="TxtDate"
                Grid.Row="1"
                Grid.Column="1"
								TextAlignment="Center"
								
								FontSize="48"
                Background="Transparent"
                Foreground="White"
							/>
        </Grid>
		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="40"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="40"/>
			</Grid.RowDefinitions>
			
			<TextBlock Grid.Row="0" TextAlignment="Center" FontSize="30" Foreground="White">
				Termine an diesem Tag:	
			</TextBlock>
			
				<DataGrid
					Grid.Row="1"
          x:Name="DGTermine"
          AutoGenerateColumns="false"
          Background="Transparent"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          GridLinesVisibility="All"
          HeadersVisibility="Column"
          IsReadOnly="True"/>

					<Button Style="{DynamicResource ButtonStyle1}" Grid.Row="2" Name="CreateTerminButton" Click="CreateTerminButton_Click" Content="Termin anlegen" Width="100"></Button>
        </Grid>
    </Grid>
</Page>

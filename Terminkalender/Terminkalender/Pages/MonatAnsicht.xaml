<Page x:Class="Terminkalender.MonatAnsicht"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Terminkalender"
      mc:Ignorable="d" 
      d:DesignHeight="542" 
			d:DesignWidth="800"
      Title="MonatAnsicht">
	<Page.Resources>
		<ResourceDictionary Source="/ResourceDictonaries/MergedCalendar.xaml"/>
	</Page.Resources>

	<Grid Background="Transparent">
		<Calendar 
			Name="MontlyCalender"
			Background="Transparent"
			Style="{DynamicResource CalendarStyle1}"
			CalendarButtonStyle="{DynamicResource CalendarCalendarButtonStyle}"
			CalendarDayButtonStyle="{DynamicResource CalendarCalendarDayButtonStyle}"
			CalendarItemStyle="{DynamicResource CalendarCalendarItemStyle}"
			VerticalAlignment="Stretch" 
			HorizontalAlignment="Stretch"
			SelectedDatesChanged="MontlyCalender_SelectedDatesChanged">
			
		</Calendar>
	</Grid>
</Page>

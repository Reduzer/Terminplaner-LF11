<Page x:Class="Terminkalender.Pages.WochenAnsicht"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Terminkalender.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WochenAnsicht"
			ShowsNavigationUI="False">


    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="Gray">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FC466B" Offset="0"/>
                    <GradientStop Color="#3F5EFB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <UniformGrid Columns="8">
                <TextBlock Text="Monat" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Montag" HorizontalAlignment="Center"/>
                <TextBlock Text="Dienstag" HorizontalAlignment="Center"/>
                <TextBlock Text="Mittwoch" HorizontalAlignment="Center"/>
                <TextBlock Text="Donnerstag" HorizontalAlignment="Center"/>
                <TextBlock Text="Freitag" HorizontalAlignment="Center"/>
                <TextBlock Text="Samstag" HorizontalAlignment="Center"/>
                <TextBlock Text="Sonntag" HorizontalAlignment="Center"/>
            </UniformGrid>
        </Border>

        <Border Grid.ColumnSpan="6" Grid.RowSpan="6" Grid.Row="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3b3b3b" Offset="0"/>
                    <GradientStop Color="#3b3b3b" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Wochenübersicht -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <!-- Uhrzeiten -->
                <ColumnDefinition Width="*"/>
                <!-- Montag -->
                <ColumnDefinition Width="*"/>
                <!-- Dienstag -->
                <ColumnDefinition Width="*"/>
                <!-- Mittwoch -->
                <ColumnDefinition Width="*"/>
                <!-- Donnerstag -->
                <ColumnDefinition Width="*"/>
                <!-- Freitag -->
                <ColumnDefinition Width="*"/>
                <!-- Samstag -->
                <ColumnDefinition Width="*"/>
                <!-- Sonntag -->
            </Grid.ColumnDefinitions>

            
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 06:00 -->
                <RowDefinition Height="*"/>
                <!-- 08:00 -->
                <RowDefinition Height="*"/>
                <!-- 10:00 -->
                <RowDefinition Height="*"/>
                <!-- 12:00 -->
                <RowDefinition Height="*"/>
                <!-- 14:00 -->
                <RowDefinition Height="*"/>
                <!-- 16:00 -->
                <RowDefinition Height="*"/>
                <!-- 18:00 -->
                <RowDefinition Height="*"/>
                <!-- 20:00 -->
                <RowDefinition Height="*"/>
                <!-- 22:00 -->
                <RowDefinition Height="*"/>
                <!-- 00:00 -->
                <RowDefinition Height="*"/>
                <!-- 02:00 -->
                <RowDefinition Height="*"/>
                <!-- 04:00 -->
            </Grid.RowDefinitions>

            

            <!-- Uhrzeiten -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5" >
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="06:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="08:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="10:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="12:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="4" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="14:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="5" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="16:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="6" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5" >
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="18:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="7" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="20:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="8" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="22:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="9" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="00:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="10" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="02:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <Border Grid.Row="11" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" CornerRadius="5">
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="04:00" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>


            </Grid> 

        </Border>
    
    </Grid>
            



</Page>

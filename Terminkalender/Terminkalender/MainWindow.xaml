<Window
	x:Class="Terminkalender.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Terminkalender"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Terminkalender"
	MinWidth="1200"
	MinHeight="600"
	mc:Ignorable="d">
	<Window.Resources>
		<ResourceDictionary Source="/ResourceDictonaries/Buttons.xaml" />
	</Window.Resources>

	<Grid>
		<Grid.Background>
			<LinearGradientBrush>
				<GradientStop Offset="0.0" Color="#23074d" />
				<GradientStop Offset="1.0" Color="#cc5333" />
			</LinearGradientBrush>
		</Grid.Background>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="120" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0">
			<Button
				Name="ShowWeekly"
				Height="40"
				Margin="10,80,10,300"
				Click="ShowWeekly_Click"
				Content="Wochenansicht"
				Style="{DynamicResource ButtonStyle1}" />
			<Button
				Name="ShowMonthly"
				Height="40"
				Margin="10,300,10,80"
				Click="ShowMonthly_Click"
				Content="Monatsansicht"
				Style="{DynamicResource ButtonStyle1}" />
		</Grid>

		<Grid Grid.Column="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" MinWidth="490" />
				<ColumnDefinition Width="5" />
				<ColumnDefinition Width="*" MinWidth="235" />
			</Grid.ColumnDefinitions>

			<Frame
				x:Name="NavFrame"
				Grid.Column="0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				HorizontalContentAlignment="Stretch"
				VerticalContentAlignment="Stretch"
				NavigationUIVisibility="Hidden" />

			<GridSplitter
				Grid.Column="1"
				Width="5"
				HorizontalAlignment="Stretch" />

			<Frame
				x:Name="FrameTaskView"
				Grid.Column="2"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				HorizontalContentAlignment="Center"
				VerticalContentAlignment="Center"
				NavigationUIVisibility="Hidden" />
		</Grid>
	</Grid>
</Window>

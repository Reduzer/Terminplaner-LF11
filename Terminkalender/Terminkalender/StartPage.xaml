<Page x:Class="Terminkalender.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Terminkalender"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage">

    <DockPanel>
        <!-- Menü oben -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Ansichten">
                <MenuItem Header="Monatsansicht" />
                <MenuItem Header="Wochenansicht" />
            </MenuItem>
            <MenuItem Header="Aktionen">
                <MenuItem Header="Neuer Termin"/>
            </MenuItem>
        </Menu>

        <!-- Frame lädt die Pages -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>






</Page>
